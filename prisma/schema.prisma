generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @db.Uuid
  email      String     @unique
  name       String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  properties Property[]
  tenants    Tenant[]

  @@map("users")
}

model Property {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  city        String
  street      String
  postalCode  String          @map("postal_code")
  imageUrl    String?         @map("image_url")
  status      PropertyStatus  @default(ACTIVE)
  monthlyRent Decimal         @map("monthly_rent") @db.Decimal(12, 2)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  ownerId     String          @map("owner_id") @db.Uuid
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leases      Lease[]
  maintenance Maintenance[]
  documents   Document[]
  images      PropertyImage[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("properties")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String
  phone     String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leases    Lease[]

  @@unique([ownerId, email])
  @@map("tenants")
}

model Lease {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startDate     DateTime     @map("start_date") @db.Date
  endDate       DateTime     @map("end_date") @db.Date
  rentAmount    Decimal      @map("rent_amount") @db.Decimal(12, 2)
  depositAmount Decimal      @map("deposit_amount") @db.Decimal(12, 2)
  paymentDay    Int          @default(1) @map("payment_day")
  status        LeaseStatus  @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  propertyId    String       @map("property_id") @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  charges       RentCharge[]

  @@index([propertyId, status])
  @@index([tenantId])
  @@map("leases")
}

model RentCharge {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period    DateTime     @db.Date
  dueDate   DateTime     @map("due_date") @db.Date
  amount    Decimal      @db.Decimal(12, 2)
  status    ChargeStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  leaseId   String       @map("lease_id") @db.Uuid
  lease     Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@unique([leaseId, period])
  @@map("rent_charges")
}

model Payment {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount    Decimal    @db.Decimal(12, 2)
  paidAt    DateTime   @map("paid_at") @db.Date
  note      String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  chargeId  String     @map("charge_id") @db.Uuid
  charge    RentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([chargeId])
  @@map("payments")
}

model Maintenance {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  provider     String?
  cost         Decimal?          @db.Decimal(12, 2)
  status       MaintenanceStatus @default(OPEN)
  resolvedDate DateTime?         @map("resolved_date") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  propertyId   String            @map("property_id") @db.Uuid
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@map("maintenance_records")
}

model Document {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  fileUrl    String   @map("file_url")
  fileSize   Int      @map("file_size")
  fileType   String   @map("file_type")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("documents")
}

model PropertyImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

enum LeaseStatus {
  ACTIVE
  ENDED

  @@map("lease_status")
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID

  @@map("charge_status")
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED

  @@map("maintenance_status")
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE

  @@map("property_status")
}
