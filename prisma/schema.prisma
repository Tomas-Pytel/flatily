generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Conventions
//  - DB: snake_case, plural tables (@@map / @map); Prisma Client API stays camelCase
//  - Instants: timestamptz. Calendar dates (lease/charge/payment dates): @db.Date
//  - Money: Decimal(12,2), single currency (EUR)
//  - CHECK constraints, partial unique index and RLS live in prisma/sql/*.sql
//    (Prisma cannot express them) and must be appended to the init migration.
// ─────────────────────────────────────────────────────────────────────────────

/// Application profile. `id` = auth.users.id (FK + sync trigger: prisma/sql/auth_sync.sql)
model User {
  id         String     @id @db.Uuid
  email      String     @unique
  name       String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  properties Property[]
  tenants    Tenant[]

  @@map("users")
}

/// One property = one rentable flat. A block of flats = several properties.
model Property {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  city        String
  street      String
  postalCode  String          @map("postal_code")
  /// Denormalized primary image (one of property_images.url) shown in lists
  imageUrl    String?         @map("image_url")
  status      PropertyStatus  @default(ACTIVE)
  /// Expected/asking rent. The actual rent is leases.rent_amount.
  monthlyRent Decimal         @map("monthly_rent") @db.Decimal(12, 2)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  ownerId     String          @map("owner_id") @db.Uuid
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leases      Lease[]
  maintenance Maintenance[]
  documents   Document[]
  images      PropertyImage[]

  // list page: WHERE owner_id = ? ORDER BY created_at DESC
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("properties")
}

/// Person renting from an owner. Owned by the landlord, reusable across leases.
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  /// stored lower-cased by the application
  email     String
  phone     String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leases    Lease[]

  // also serves as the index for owner_id lookups
  @@unique([ownerId, email])
  @@map("tenants")
}

/// Tenancy of one property by one tenant. At most ONE ACTIVE lease per property
/// (partial unique index). Ended leases are kept as history.
model Lease {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startDate     DateTime     @map("start_date") @db.Date
  endDate       DateTime     @map("end_date") @db.Date
  rentAmount    Decimal      @map("rent_amount") @db.Decimal(12, 2)
  depositAmount Decimal      @map("deposit_amount") @db.Decimal(12, 2)
  /// day of month rent is due, 1-28
  paymentDay    Int          @default(1) @map("payment_day")
  status        LeaseStatus  @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  propertyId    String       @map("property_id") @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // NoAction: financial history must not disappear when a tenant row is deleted
  // (still cascades when the whole owner/property is removed)
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  charges       RentCharge[]

  @@index([propertyId, status])
  @@index([tenantId])
  @@map("leases")
}

/// Rent due for one month of a lease (generated for the whole term on lease creation).
/// "Overdue" is derived (status != PAID and due_date < today), never stored.
model RentCharge {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// first day of the month the charge belongs to
  period    DateTime     @db.Date
  dueDate   DateTime     @map("due_date") @db.Date
  amount    Decimal      @db.Decimal(12, 2)
  /// derived from payments, kept in sync by syncChargeStatus()
  status    ChargeStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  leaseId   String       @map("lease_id") @db.Uuid
  lease     Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments  Payment[]

  // idempotent generation + serves "charges of a lease ordered by period"
  @@unique([leaseId, period])
  @@map("rent_charges")
}

/// Money received against a charge (supports partial payments).
model Payment {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount    Decimal    @db.Decimal(12, 2)
  paidAt    DateTime   @map("paid_at") @db.Date
  note      String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  chargeId  String     @map("charge_id") @db.Uuid
  charge    RentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([chargeId])
  @@map("payments")
}

model Maintenance {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  provider     String?
  /// unknown until the work is done
  cost         Decimal?          @db.Decimal(12, 2)
  status       MaintenanceStatus @default(OPEN)
  /// set if and only if status = RESOLVED (CHECK constraint)
  resolvedDate DateTime?         @map("resolved_date") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  propertyId   String            @map("property_id") @db.Uuid
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@map("maintenance_records")
}

model Document {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  fileUrl    String   @map("file_url")
  fileSize   Int      @map("file_size")
  fileType   String   @map("file_type")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("documents")
}

model PropertyImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

enum LeaseStatus {
  ACTIVE
  ENDED

  @@map("lease_status")
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID

  @@map("charge_status")
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED

  @@map("maintenance_status")
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE

  @@map("property_status")
}
