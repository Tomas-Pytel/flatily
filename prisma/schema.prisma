generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// USER + SETTINGS  (frontend: UserProfile)
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  phone     String?
  company   String?
  ico       String?
  dic       String?
  iban      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings      UserSettings?
  properties    Property[]
  tenants       Tenant[]
  documents     Document[]
  maintenance   Maintenance[]
  notifications Notification[]

  @@map("users")
}

model UserSettings {
  id                       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currency                 String  @default("EUR")
  language                 String  @default("sk")
  timezone                 String  @default("Europe/Bratislava")
  notificationsEmail       Boolean @default(true) @map("notifications_email")
  notificationsPush        Boolean @default(true) @map("notifications_push")
  contractExpiryNoticeDays Int     @default(30) @map("contract_expiry_notice_days")
  userId                   String  @unique @map("user_id") @db.Uuid
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─────────────────────────────────────────────────────────────
// PROPERTY  (frontend: Apartment)
// ─────────────────────────────────────────────────────────────

model Property {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String // "2-izbový byt, Hlavná 24"
  description     String?
  street          String // "Hlavná 24"
  city            String
  district        String?
  postalCode      String         @map("postal_code")
  imageUrl        String?        @map("image_url") // cover photo
  status          PropertyStatus @default(VACANT)
  monthlyRent     Decimal        @map("monthly_rent") @db.Decimal(12, 2)
  utilitiesAmount Decimal        @default(0) @map("utilities_amount") @db.Decimal(12, 2)
  depositAmount   Decimal        @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  rooms           Int            @default(1)
  area            Decimal        @db.Decimal(7, 2) // m²
  floor           Int            @default(0)
  totalFloors     Int            @default(1) @map("total_floors")
  hasElevator     Boolean        @default(false) @map("has_elevator")
  hasBalcony      Boolean        @default(false) @map("has_balcony")
  hasCellar       Boolean        @default(false) @map("has_cellar")
  equipment       String[] // ["Práčka", "Klimatizácia", ...]
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerId     String          @map("owner_id") @db.Uuid
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leases      Lease[]
  maintenance Maintenance[]
  documents   Document[]
  images      PropertyImage[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([ownerId, status])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("property_images")
}

// ─────────────────────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────────────────────

model Tenant {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String       @map("first_name")
  lastName     String       @map("last_name")
  email        String
  phone        String?
  idCardNumber String?      @map("id_card_number")
  notes        String?
  imageUrl     String?      @map("image_url")
  status       TenantStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerId   String     @map("owner_id") @db.Uuid
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leases    Lease[]
  documents Document[]

  @@unique([ownerId, email])
  @@index([ownerId, status])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────
// LEASE  (frontend: Contract)
// ─────────────────────────────────────────────────────────────

model Lease {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  rentAmount    Decimal     @map("rent_amount") @db.Decimal(12, 2)
  depositAmount Decimal     @map("deposit_amount") @db.Decimal(12, 2)
  paymentDay    Int         @default(1) @map("payment_day")
  autoRenew     Boolean     @default(false) @map("auto_renew")
  notes         String?
  // "konci_coskoro" is NOT stored – derive it: ACTIVE && endDate - today <= settings.contractExpiryNoticeDays
  status        LeaseStatus @default(DRAFT)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  propertyId String       @map("property_id") @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  charges    RentCharge[]
  documents  Document[]

  @@index([propertyId, status])
  @@index([tenantId])
  @@index([status, endDate])
  @@map("leases")
}

// ─────────────────────────────────────────────────────────────
// RENT CHARGES + PAYMENTS  (frontend: Payment)
//
// RentCharge = monthly "predpis" (what is owed)
// Payment    = actual money received (supports partial payments)
//
// "omeskane" is NOT stored – derive it: status != PAID && dueDate < today
// paidDate in the UI = latest Payment.paidAt of the charge
// ─────────────────────────────────────────────────────────────

model RentCharge {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period         DateTime     @db.Date // first day of month, UI shows "Október 2026"
  dueDate        DateTime     @map("due_date") @db.Date
  amount         Decimal      @db.Decimal(12, 2)
  variableSymbol String?      @map("variable_symbol")
  note           String?
  status         ChargeStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  leaseId  String    @map("lease_id") @db.Uuid
  lease    Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([leaseId, period])
  @@index([status, dueDate])
  @@map("rent_charges")
}

model Payment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @map("paid_at") @db.Date
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  chargeId String     @map("charge_id") @db.Uuid
  charge   RentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([chargeId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// MAINTENANCE  (frontend: MaintenanceItem)
// reportedDate in the UI = createdAt
// ─────────────────────────────────────────────────────────────

model Maintenance {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  description   String?
  priority      MaintenancePriority @default(MEDIUM)
  status        MaintenanceStatus   @default(OPEN)
  contractor    String?
  estimatedCost Decimal?            @map("estimated_cost") @db.Decimal(12, 2)
  actualCost    Decimal?            @map("actual_cost") @db.Decimal(12, 2)
  resolvedDate  DateTime?           @map("resolved_date") @db.Date
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerId    String   @map("owner_id") @db.Uuid
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([ownerId, status, priority])
  @@map("maintenance_records")
}

// ─────────────────────────────────────────────────────────────
// DOCUMENT
// propertyId is optional: UI allows "Všeobecný dokument (všetky byty)"
// fileSize is bytes – format to "1.4 MB" in the UI
// ─────────────────────────────────────────────────────────────

model Document {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  category  DocumentCategory @default(OTHER)
  fileUrl   String           @map("file_url")
  fileSize  Int              @map("file_size")
  fileType  String           @map("file_type") // pdf | docx | jpg | png | xlsx
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  ownerId    String    @map("owner_id") @db.Uuid
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId String?   @map("property_id") @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId   String?   @map("tenant_id") @db.Uuid
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  leaseId    String?   @map("lease_id") @db.Uuid
  lease      Lease?    @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@index([ownerId, category])
  @@index([propertyId])
  @@index([tenantId])
  @@index([leaseId])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS  (frontend: AppNotification)
// actionRoute + actionEntityId let the drawer deep-link to the record
// ─────────────────────────────────────────────────────────────

model Notification {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           NotificationType
  severity       NotificationSeverity @default(INFO)
  title          String
  message        String
  read           Boolean              @default(false)
  actionRoute    String?              @map("action_route")
  actionEntityId String?              @map("action_entity_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum PropertyStatus {
  OCCUPIED // obsadeny
  VACANT // volny
  PROBLEM // problem

  @@map("property_status")
}

enum TenantStatus {
  ACTIVE // aktivny
  PENDING // cakajuci
  ENDED // ukonceny

  @@map("tenant_status")
}

enum LeaseStatus {
  DRAFT // draft
  ACTIVE // aktivna
  ENDED // ukoncena
  EXPIRED // expirovana

  @@map("lease_status")
}

enum ChargeStatus {
  PENDING // cakajuce
  PARTIAL // ciastocne
  PAID // uhradene

  @@map("charge_status")
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("maintenance_priority")
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED

  @@map("maintenance_status")
}

enum DocumentCategory {
  CONTRACTS // zmluvy
  INVOICES // faktury
  RECORDS // doklady
  REPAIRS // opravy
  PROPERTY // byty
  OTHER // ostatne

  @@map("document_category")
}

enum NotificationType {
  PAYMENT_OVERDUE
  CONTRACT_EXPIRING
  URGENT_REPAIR
  PAYMENT_RECEIVED
  REPAIR_RESOLVED
  NEW_DOCUMENT

  @@map("notification_type")
}

enum NotificationSeverity {
  ERROR
  WARNING
  SUCCESS
  INFO

  @@map("notification_severity")
}
